rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Strict admin check: only the verified master admin account
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'yayele492@gmail.com'
      );
    }

    // Safely checks access arrays without throwing errors on missing fields/docs
    function hasAnyAccess() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userPath) && (
        get(userPath).data.get('paidPackages', []).size() > 0 ||
        get(userPath).data.get('allowedExams', []).size() > 0
      );
    }

    // User profiles security:
    // Regular students can read/update their own profile and create their own profile with 'student' role.
    // They CANNOT tamper with or escalate 'role' to admin.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && (
        isAdmin() || (
          request.auth.uid == userId &&
          (!('role' in request.resource.data) || request.resource.data.role == 'student')
        )
      );
      allow update: if isAdmin() || (
        isOwner(userId) &&
        // Prevent privilege escalation: students cannot escalate role to admin
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
      );
      allow delete: if isAdmin();
    }

    match /paymentSubmissions/{submissionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      // Students can create payment submissions for their own user ID:
      // status 'pending' for manual review, or status 'approved' for auto-verified SMS payments
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid &&
        (request.resource.data.status == 'pending' || request.resource.data.status == 'approved');
      // Only the verified admin can approve, reject, or delete payment submissions
      allow update, delete: if isAdmin();
    }

    match /examAttempts/{attemptId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Exams: admins can write; paid users or admin can read
    match /exams/{examId} {
      allow read: if isAdmin() || (isAuthenticated() && hasAnyAccess());
      allow write: if isAdmin();
    }

    // Questions: same access rule as exams
    match /questions/{questionId} {
      allow read: if isAdmin() || (isAuthenticated() && hasAnyAccess());
      allow write: if isAdmin();
    }

    // Transactions captured by the SMS app (Telebirr 127 SMS listener)
    // Used for automatic payment verification on the web frontend.
    // Read and write are enabled so SMS app can push transactions and web app can verify.
    match /payment_from_127/{txnId} {
      allow read, write: if true;
    }

    match /transactions/{txnId} {
      allow read, write: if true;
    }

    match /telebirr_transactions/{txnId} {
      allow read, write: if true;
    }

    match /sms_transactions/{txnId} {
      allow read, write: if true;
    }

    // Admin config (e.g. hiddenExamIds): admins write, any authenticated user reads
    match /config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}