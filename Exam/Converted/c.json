      "id": "q_c_melmeja_1",
      "examId": "c_melmeja",
      "number": 1,
      "questionType": "single_choice",
      "questionText": "Which of the following statements best distinguishes a Lewis acid from a Brønsted acid?",
      "options": [
        "Lewis acids donate H⁺ ions while Brønsted acids accept electron pairs.",
        "Lewis acids accept electron pairs while Brønsted acids donate H⁺ ions.",
        "Both donate H⁺ ions.",
        "Lewis acids and Brønsted acids are identical."
      ],
      "correctAnswerIndex": 1,
      "explanation": "Brønsted acids are proton donors, while Lewis acids accept electron pairs.",
      "topic": "Chemistry"
    },
    {
      "id": "q_c_melmeja_2",
      "examId": "c_melmeja",
      "number": 2,
      "questionType": "single_choice",
      "questionText": "The conjugate base of H₂PO₄⁻ is:",
      "options": [
        "HPO₄²⁻",
        "H₃PO₄",
        "PO₄³⁻",
        "H₂PO₄⁻ itself"
      ],
      "correctAnswerIndex": 0,
      "explanation": "Removing one proton from H₂PO₄⁻ gives HPO₄²⁻ — its conjugate base.",
      "topic": "Chemistry"
    },
    {
      "id": "q_c_melmeja_3",
      "examId": "c_melmeja",
      "number": 3,
      "questionType": "single_choice",
      "questionText": "In the reaction NH₃ + H₂O ⇌ NH₄⁺ + OH⁻, the conjugate acid–base pairs are:",
      "options": [
        "NH₄⁺/NH₃ and OH⁻/H₂O",
        "NH₃/NH₄⁺ and H₂O/OH⁻",
        "NH₃/OH⁻ and NH₄⁺/H₂O",
        "NH₃/H₂O and NH₄⁺/OH⁻"
      ],
      "correctAnswerIndex": 1,
      "explanation": "NH₃ ⇌ NH₄⁺ and H₂O ⇌ OH⁻ are conjugate acid–base pairs.",
      "topic": "Chemistry"
    },
    {
      "id": "q_c_melmeja_4",
      "examId": "c_melmeja",
      "number": 4,
      "questionType": "single_choice",
      "questionText": "Which of the following represents an amphiprotic species?",
      "options": [
        "NO₃⁻",
        "H₂PO₄⁻",
        "NH₄⁺",
        "CH₃COO⁻"
      ],
      "correctAnswerIndex": 1,
      "explanation": "H₂PO₄⁻ can both donate and accept a proton, hence amphiprotic.",
      "topic": "Chemistry"
    },
