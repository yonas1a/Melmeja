        "id": 1,
        "question": "Which of the following statements best distinguishes a Lewis acid from a Brønsted acid?",
        "options": {
            "A": "Lewis acids donate H⁺ ions while Brønsted acids accept electron pairs.",
            "B": "Lewis acids accept electron pairs while Brønsted acids donate H⁺ ions.",
            "C": "Both donate H⁺ ions.",
            "D": "Lewis acids and Brønsted acids are identical."
        },
        "answer": "B",
        "explanation": "Brønsted acids are proton donors, while Lewis acids accept electron pairs."
    },
    {
        "id": 2,
        "question": "The conjugate base of H₂PO₄⁻ is:",
        "options": {
            "A": "HPO₄²⁻",
            "B": "H₃PO₄",
            "C": "PO₄³⁻",
            "D": "H₂PO₄⁻ itself"
        },
        "answer": "A",
        "explanation": "Removing one proton from H₂PO₄⁻ gives HPO₄²⁻ — its conjugate base."
    },
    {
        "id": 3,
        "question": "In the reaction NH₃ + H₂O ⇌ NH₄⁺ + OH⁻, the conjugate acid–base pairs are:",
        "options": {
            "A": "NH₄⁺/NH₃ and OH⁻/H₂O",
            "B": "NH₃/NH₄⁺ and H₂O/OH⁻",
            "C": "NH₃/OH⁻ and NH₄⁺/H₂O",
            "D": "NH₃/H₂O and NH₄⁺/OH⁻"
        },
        "answer": "B",
        "explanation": "NH₃ ⇌ NH₄⁺ and H₂O ⇌ OH⁻ are conjugate acid–base pairs."
    },
    {
        "id": 4,
        "question": "Which of the following represents an amphiprotic species?",
        "options": {
            "A": "NO₃⁻",
            "B": "H₂PO₄⁻",
            "C": "NH₄⁺",
            "D": "CH₃COO⁻"
        },
        "answer": "B",
        "explanation": "H₂PO₄⁻ can both donate and accept a proton, hence amphiprotic."
